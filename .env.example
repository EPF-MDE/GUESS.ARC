# Configuration du client LLM de l'extraction des événements.
# Copier en `.env` (hors git) à la racine du repo et remplir chaque variable :
# aucune n'a de valeur par défaut dans le code, une variable vide arrête le passage.
# Seul ce fichier est lu, pas les variables d'environnement du shell.

# Adresse du serveur, sans chemin (ex. le serveur de l'école).
LLM_BASE_URL=https://locallm.mde.epf.fr

# Clé API (Open WebUI : Settings > Account > API keys).
LLM_API_KEY=

# Identifiant exact du modèle, tel que le serveur le liste :
# scripts/llm/diagnostic_serveur.py les affiche si cette variable est vide.
LLM_MODEL=

# Forme de la route d'appel : `openai` (chat completions compatible OpenAI)
# ou `ollama` (API native d'Ollama), et son chemin sur le serveur.
# Le diagnostic indique la route qui applique vraiment le schéma JSON.
LLM_API=
LLM_CHAT_PATH=
