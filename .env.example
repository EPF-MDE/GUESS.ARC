# Copy to .env at the repo root and fill in. .env is ignored by git.
# Models are set here only: the code has no default model.

# Vectorisation encoder (Hugging Face id), required by `python -m guess_arc.vectorisation`.
# Documented example: 384 dimensions, 512-token window.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
